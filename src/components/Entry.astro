---
/**
 * One large photo in the Viewer feed. Captioned image-frame; the page
 * scrolls normally. data-slug is the anchor a grid thumbnail / deep-link
 * resolves to. Albums get the stacked frame + "▣ Photo album" pill + a
 * prominent "view album →"; singles get a quiet "full ↗" to the original.
 */
import { Image, getImage } from 'astro:assets';
import { photoExifLine, formatDate, type GalleryItem } from '../lib/photos';
import { viewerAttrs, fullRendition } from '../lib/images';
import { withBase } from '../lib/url';

interface Props {
  item: GalleryItem;
  /** Position in the Viewer feed — announced when keyboard nav lands here. */
  index: number;
  total: number;
}

const { item, index, total } = Astro.props;
const isAlbum = item.kind === 'album';
const photo = item.photo;
const title = isAlbum ? item.album.title : photo.title;
const date = formatDate(item.date);
const sub = isAlbum ? `${item.album.photos.length} photos` : photoExifLine(photo) || photo.caption;
const full = await getImage(fullRendition(photo.image));
const albumHref = isAlbum ? withBase(`${item.slug}/`) : undefined;
---

<article
  class="gv-entry"
  data-slug={item.slug}
  id={item.slug}
  tabindex="-1"
  aria-label={`${index + 1} of ${total}: ${title}`}
>
  <figure class:list={['gv-frame', { 'gv-frame--album': isAlbum }]}>
    <Image
      class="gv-img"
      src={photo.image}
      {...viewerAttrs(photo.image)}
      alt={photo.alt}
      loading="lazy"
    />
    {
      isAlbum && (
        /* Pointer-only full-frame click target; the caption link is the
           keyboard/SR target. */
        <a class="gv-img-link" href={albumHref} tabindex="-1" aria-hidden="true" />
      )
    }
    <figcaption class="gv-bar">
      <span class="gv-cap">
        {isAlbum && <span class="gv-cap-mark" title="Photo album — many images on its page">▣&nbsp;Photo album</span>}
        <b class="gv-cap-title">{title}</b>
        {date && <span class="gv-cap-date">· {date}</span>}
        {sub && <span class="gv-cap-sub">· {sub}</span>}
      </span>
      {
        isAlbum ? (
          <a class="gv-act" href={albumHref}>
            view album <span class="gv-act-ar">→</span>
          </a>
        ) : (
          <a
            class="gv-act gv-act--quiet"
            href={full.src}
            target="_blank"
            rel="noopener"
            aria-label={`Open full-size image of ${title}`}
          >
            full <span class="gv-act-ar">↗</span>
          </a>
        )
      }
    </figcaption>
  </figure>
</article>
