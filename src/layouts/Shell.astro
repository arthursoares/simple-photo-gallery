---
import config from '../../gallery.config';
import { withBase } from '../lib/url';
import { navPages } from '../lib/pages';
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/shell.css';
import '../styles/gallery.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import KebabNav from '../components/KebabNav.astro';
import atkinsonUrl from '../assets/fonts/AtkinsonHyperlegibleNext-VariableFont_wght.woff2?url';

interface Props {
  title?: string;
  description?: string;
  /** Right-side counter text, e.g. "24 photos". */
  count?: string;
  /** Preview image for social cards — a built rendition's src. */
  image?: string;
}

const { title, description, count, image } = Astro.props;
const pageTitle = title ? `${title} — ${config.title}` : config.title;
const pageDescription = description ?? config.description;
const chrome = config.chrome;

/* Social cards and the canonical link need absolute URLs, which only exist
   once `site` is known (the Pages workflow injects SITE_URL; locally it is
   unset and these tags are simply omitted). */
const absolute = (p: string) => (Astro.site ? new URL(p, Astro.site).href : undefined);
const canonical = absolute(Astro.url.pathname);
const ogImage = image ? absolute(image) : undefined;

/* Chrome menu = markdown entry pages (src/content/pages/, nav: true)
   followed by the manual links from gallery.config nav. */
const pageLinks = (await navPages()).map((p) => ({
  label: p.data.navLabel ?? p.data.title.toLowerCase(),
  href: withBase(`${p.id}/`),
  external: false,
}));
/* Schemes that may appear verbatim in a nav href. Anything else with a scheme
   (notably `javascript:`) is refused rather than rendered into an anchor. */
const SAFE_SCHEMES = /^(https?|mailto|tel):/i;
const configLinks = (config.nav ?? []).map((link) => {
  const hasScheme = /^[a-z][a-z0-9+.-]*:/i.test(link.href);
  if (hasScheme && !SAFE_SCHEMES.test(link.href)) {
    throw new Error(
      `gallery.config.ts: nav link "${link.label}" uses an unsupported URL scheme ` +
        `(${link.href}). Use http(s), mailto, tel, or a site-relative path.`
    );
  }
  const external = /^https?:\/\//i.test(link.href);
  return { ...link, external, href: hasScheme ? link.href : withBase(link.href) };
});
const nav = [...pageLinks, ...configLinks];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:site_name" content={config.title} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    {config.author && <meta name="author" content={config.author} />}
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <link rel="preload" href={atkinsonUrl} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      /* Theme init — runs before paint so there is no flash. */
      (function () {
        var saved = localStorage.getItem('theme');
        var dark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.setAttribute(
          'data-theme',
          saved === 'light' || saved === 'dark' ? saved : dark ? 'dark' : 'light'
        );
      })();
    </script>
  </head>
  <body data-chrome={chrome} data-mobile-nav={config.mobileNav ?? 'kebab'}>
    <!-- Underscore-prefixed so it can never collide with a photo slug
         (slugify only ever emits [a-z0-9-]), which entries use as their id. -->
    <a class="skip-link" href="#_content">Skip to content</a>
    <div class="app-frame">
      {
        chrome === 'frame' && (
          <>
            <span class="float-chip float-chip--tl">
              <a class="chrome-title" href={withBase("")}>
                <span class="chrome-mark">▧</span> {config.title}
              </a>
              <nav class="chrome-nav">
                {nav.map((l) => (
                  <a href={l.href} target={l.external ? '_blank' : undefined} rel={l.external ? 'noopener' : undefined}>
                    {l.label}
                  </a>
                ))}
              </nav>
            </span>
            <span class="float-chip float-chip--tr">
              <ThemeToggle />
              <KebabNav nav={nav} />
            </span>
          </>
        )
      }
      <div class="site">
        {
          chrome === 'header' && (
            <header class="topbar">
              <a class="chrome-title" href={withBase("")}>
                <span class="chrome-mark">▧</span> {config.title}
              </a>
              <nav class="chrome-nav">
                {nav.map((l) => (
                  <a href={l.href} target={l.external ? '_blank' : undefined} rel={l.external ? 'noopener' : undefined}>
                    {l.label}{l.external && <span class="chrome-nav-ext">↗</span>}
                  </a>
                ))}
              </nav>
              {count && <span class="chrome-count">{count}</span>}
              <ThemeToggle />
              <KebabNav nav={nav} />
            </header>
          )
        }
        {
          chrome === 'rail' && (
            <aside class="rail">
              <span class="chrome-mark" aria-hidden="true">▧</span>
              <a class="rail-title" href={withBase("")}>{config.title}</a>
              <nav class="chrome-nav">
                {nav.map((l) => (
                  <a href={l.href} target={l.external ? '_blank' : undefined} rel={l.external ? 'noopener' : undefined}>
                    {l.label}
                  </a>
                ))}
              </nav>
              {count && <span class="chrome-count">{count}</span>}
              <ThemeToggle />
              <KebabNav nav={nav} />
            </aside>
          )
        }
        <div class="site-content" id="_content" tabindex="-1">
          <slot />
          <div class="content-end">
            <span class="content-end-text">░▒▓ EOF ▓▒░</span>
          </div>
        </div>
      </div>
    </div>
    <script>
      /* Keyboard scrolling works immediately without a click — but never steal
         focus from a fragment target (/#photo-slug, or the skip link), which
         the browser has already resolved by the time this runs. */
      if (!location.hash) {
        document.querySelector<HTMLElement>('.site-content')?.focus({ preventScroll: true });
      }
    </script>
  </body>
</html>
