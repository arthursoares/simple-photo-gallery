---
import { getImage } from 'astro:assets';
import config from '../../gallery.config';
import Shell from '../layouts/Shell.astro';
import GalleryIndex from '../components/GalleryIndex.astro';
import AlbumFeed from '../components/AlbumFeed.astro';
import Lightbox from '../components/Lightbox.astro';
import { getGallery, singleAlbum, formatDate, type GalleryItem } from '../lib/photos';
import { ogRendition } from '../lib/images';

const gallery = await getGallery();
/* Single mode: the site IS one album — a real album, or the loose photos
   wrapped in one (see singleAlbum). With no content at all this is null and
   we fall through to gallery rendering, which has the proper empty state. */
const album = singleAlbum(gallery);

const items: GalleryItem[] = album
  ? album.photos.map((p) => ({ kind: 'photo' as const, slug: p.slug, date: p.date, photo: p }))
  : gallery.items;

const essay = album !== null && config.presentation === 'essay';
const photoCount = album
  ? album.photos.length
  : gallery.singles.length + gallery.albums.reduce((n, a) => n + a.photos.length, 0);

const title = album && album.title !== config.title ? album.title : config.title;
const date = album ? formatDate(album.date) : undefined;

const ogPhoto = album?.cover ?? gallery.items[0]?.photo;
const ogImage = ogPhoto ? (await getImage(ogRendition(ogPhoto.image))).src : undefined;
---

<Shell count={`${photoCount} photos`} image={ogImage}>
  <main class="site-main">
    <section class="w-pgh">
      <div class="w-pgh-kick">
        <span class="w-pgh-kick-mark">▧</span>
        {title}
        {
          date && (
            <>
              <span class="w-pgh-kick-sep">·</span>
              <span>{date}</span>
            </>
          )
        }
        <span class="w-pgh-kick-sep">·</span>
        <span>{photoCount} photos</span>
      </div>
      <h1 class="w-pgh-title">{title}</h1>
      {config.description && <p class="w-pgh-excerpt">{config.description}</p>}
    </section>

    {
      essay && album ? (
        <AlbumFeed photos={album.photos} entry={album.entry} />
      ) : (
        <GalleryIndex items={items} />
      )
    }
  </main>
  {essay && <Lightbox />}
</Shell>
